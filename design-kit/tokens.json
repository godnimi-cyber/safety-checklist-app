{
  "kitContractVersion": 2,
  "preset": "control",
  "core": "uiux-core@1",
  "variant": {
    "density": "comfortable",
    "motion": "subtle"
  },
  "spacing": {
    "unit": "8px"
  },
  "motionDuration": "160ms",
  "components": {
    "button": {
      "sizes": {
        "sm": {
          "height": 32,
          "paddingX": 12
        },
        "md": {
          "height": 40,
          "paddingX": 16
        },
        "lg": {
          "height": 48,
          "paddingX": 24
        }
      },
      "states": [
        "default",
        "hover",
        "active",
        "disabled",
        "focus"
      ],
      "disabledOpacity": 0.5
    },
    "iconButton": {
      "size": 40,
      "paddingX": 0
    },
    "input": {
      "sizes": {
        "sm": {
          "height": 32,
          "paddingY": 8,
          "paddingX": 12
        },
        "md": {
          "height": 40,
          "paddingY": 8,
          "paddingX": 12
        },
        "lg": {
          "height": 48,
          "paddingY": 12,
          "paddingX": 16
        }
      },
      "states": [
        "default",
        "hover",
        "focus",
        "error",
        "disabled"
      ]
    },
    "badge": {
      "sizes": {
        "sm": {
          "height": 20,
          "paddingY": 4,
          "paddingX": 8
        },
        "md": {
          "height": 24,
          "paddingY": 4,
          "paddingX": 10
        },
        "lg": {
          "height": 28,
          "paddingY": 6,
          "paddingX": 12
        }
      }
    },
    "dialog": {
      "maxWidthPx": {
        "sm": 384,
        "md": 512,
        "lg": 640,
        "xl": 768
      }
    },
    "table": {
      "rowHeights": {
        "compact": 40,
        "default": 48,
        "comfortable": 56
      },
      "cellPadding": {
        "y": 12,
        "x": 16
      },
      "states": [
        "default",
        "hover",
        "selected"
      ]
    },
    "card": {
      "padding": {
        "headerTop": 24,
        "headerX": 24,
        "headerBottom": 0,
        "content": 24,
        "footerTop": 0,
        "footerX": 24,
        "footerBottom": 24
      },
      "gap": 16,
      "interactiveShadow": [
        "sm",
        "md"
      ]
    }
  },
  "visual": {
    "radiusPx": {
      "control": 8,
      "card": 12,
      "dialog": 12,
      "pill": 999
    },
    "fontWeight": {
      "control": 600
    },
    "fontSizeRem": {
      "badge": 0.78
    },
    "gapPx": {
      "control": 8
    },
    "borderWidthPx": 1,
    "selectedIndicatorPx": 3,
    "focusOutlinePx": {
      "width": 2,
      "offset": 2
    }
  },
  "accessibility": {
    "touchTargetPx": {
      "apple": 44,
      "material": 48
    },
    "bodyLineLengthCh": [
      45,
      75
    ],
    "lineHeightMin": 1.5,
    "contrast": {
      "text": 4.5,
      "largeText": 3,
      "uiBoundary": 3
    },
    "focusVisibleRequired": true,
    "reducedMotionRequired": true,
    "transitionMs": [
      150,
      300
    ]
  },
  "colors": {
    "light": {
      "bg": "#f1f6f5",
      "surface": "#ffffff",
      "text": "#0f2724",
      "muted": "#40615b",
      "accent": "#0c7261",
      "accent2": "#8f5a10",
      "ok": "#1a7f45",
      "warn": "#93590f",
      "danger": "#b13330",
      "border": "#cedcd9",
      "accent-hover": "#0b6757",
      "accent-active": "#0a5b4e",
      "on-accent": "#f1f6f5",
      "focus-ring": "#0c7261",
      "row-hover": "#f5f6f6",
      "row-selected": "#e7f1ef"
    },
    "dark": {
      "bg": "#0a1214",
      "surface": "#101c1f",
      "text": "#d9ecea",
      "muted": "#8fadaa",
      "accent": "#3fd2b4",
      "accent2": "#e0a34c",
      "ok": "#4ecf8f",
      "warn": "#e0b054",
      "danger": "#ef8a7c",
      "border": "#1e3236",
      "accent-hover": "#6dddc6",
      "accent-active": "#71dec8",
      "on-accent": "#0a1214",
      "focus-ring": "#3fd2b4",
      "row-hover": "#182427",
      "row-selected": "#152e2e"
    }
  },
  "chartPalette": [
    "#3fd2b4",
    "#e0a34c",
    "#ef8a7c",
    "#8fadaa"
  ],
  "fonts": {
    "latin": {
      "heading": "JetBrains Mono",
      "body": "IBM Plex Sans",
      "mono": "JetBrains Mono"
    },
    "hangul": {
      "heading": "D2Coding",
      "body": "Pretendard Variable",
      "mono": "D2Coding"
    },
    "fallbackStack": "'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif"
  },
  "fontLinks": [
    "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css",
    "https://cdn.jsdelivr.net/gh/wan2land/d2coding/d2coding-subset.css",
    "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap",
    "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
  ]
}
